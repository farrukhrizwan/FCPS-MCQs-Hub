rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School configuration and question bank
    match /school_data/{document} {
      allow read, write: if true;
    }
    
    // Student test result records
    match /student_results/{document} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
